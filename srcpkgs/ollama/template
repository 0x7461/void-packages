# Uses pre-built binaries from official releases
pkgname=ollama
version=0.32.4
revision=1
archs="x86_64"
create_wrksrc=yes
short_desc="Get up and running with large language models locally"
maintainer="ta <ta@localhost>"
license="MIT"
homepage="https://ollama.com"
changelog="https://github.com/ollama/ollama/releases"
distfiles="https://github.com/ollama/ollama/releases/download/v${version}/ollama-linux-amd64.tar.zst"
checksum=c00efcc236e87168e55cad9ca7c57817762dad04ccfc4565546935facf22e359
depends="openblas"
shlib_provides="libvulkan.so.1"
nostrip=yes

do_install() {
	vbin bin/ollama

	# Ship the whole runtime tree: since 0.31.x it includes the
	# llama-server runner binary and its libs, not just libggml-*.
	# libcuda.so.1 is provided by nvidia driver package (nvidia-580+)
	vcopy lib/ollama usr/lib
}
