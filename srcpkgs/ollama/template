# Template file for 'ollama'
# Uses pre-built binaries from official releases
pkgname=ollama
version=0.20.7
revision=2
archs="x86_64"
create_wrksrc=yes
short_desc="Get up and running with large language models locally"
maintainer="ta <ta@localhost>"
license="MIT"
homepage="https://ollama.com"
changelog="https://github.com/ollama/ollama/releases"
distfiles="https://github.com/ollama/ollama/releases/download/v${version}/ollama-linux-amd64.tar.zst"
checksum=193c41ffee30411a76af4484dae9cdd4c2d6f8f877b7096925c36f2489af131f
depends="openblas"
shlib_provides="libvulkan.so.1"
nostrip=yes

do_install() {
	# Install main binary
	vbin bin/ollama

	# Install CPU, Vulkan, and CUDA runners
	# libcuda.so.1 is provided by nvidia driver package (nvidia-580+)
	vmkdir usr/lib/ollama
	for f in lib/ollama/libggml-*.so lib/ollama/libggml-base.so.*; do
		[ -f "$f" ] && vcopy "$f" usr/lib/ollama
	done
	vcopy lib/ollama/vulkan usr/lib/ollama
	vcopy lib/ollama/cuda_v12 usr/lib/ollama
	vcopy lib/ollama/cuda_v13 usr/lib/ollama
}
