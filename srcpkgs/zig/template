# Template file for 'zig'
# Prebuilt binary from ziglang.org — Void's source-build zig lags at 0.13;
# ghostty 1.4.x requires zig 0.17.
pkgname=zig
version=0.17.0
revision=1
archs="x86_64"
short_desc="Programming language designed for robustness, optimality, and clarity"
maintainer="ta <ta@localhost>"
license="MIT"
homepage="https://ziglang.org"
distfiles="https://ziglang.org/download/${version}/zig-x86_64-linux-${version}.tar.xz"
checksum=1cbe9df9f27e6b78d14ccbca43b6703a404ef79ef1c463de901d7f088d4e2026
nopie=yes
nostrip=yes

do_install() {
	vbin zig
	vmkdir usr/lib/zig
	vcopy "lib/*" usr/lib/zig/
	vlicense LICENSE
	vdoc README.md
}
